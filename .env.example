# Copy this file to .env and fill in your own API keys.
# Do not commit the .env file itself.
GEMINI_API_KEY1=
GEMINI_API_KEY2=
GEMINI_API_KEY3=
GROQ_API_KEY1=
GROQ_API_KEY2=
GROQ_API_KEY3=

# Optional: force UI dry runs without spending provider quota.
RAGC_UI_FAKE_LLM=0

# Optional: force the UI to require the configured real main provider.
RAGC_UI_REAL_LLM=0
